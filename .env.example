# ai-office の設定ファイル。
# サーバー（officed）が起動時にプロジェクトルートの .env を自動で読み込みます。
# 既に export 済みの環境変数がある場合は、そちらが優先されます（.env は上書きしません）。
#
# 使い方:
#   1) このファイルを .env にコピー:  cp .env.example .env
#   2) 実キーを使うなら OFFICE_LLM_PROVIDER を anthropic にして ANTHROPIC_API_KEY を設定
#   3) サーバー: sh scripts/server.sh   （ターミナル1）
#      クライアント: sh scripts/client.sh（ターミナル2）

# ===== サーバー =====
# サーバー
OFFICE_ADDR=:8787
# DB の場所（既定: カレントディレクトリの officed.db。*.db は gitignore 済み）
# scripts/server.sh はリポジトリ直下で起動するので、下を有効にすると server/data/run/ に置ける
# OFFICE_DB=server/data/run/office.db
OFFICE_HEARTBEAT_TIMEOUT=90s
# 給与 cron / タイムゾーン（@every 5s なども可。off で無効）
OFFICE_PAYROLL_CRON=0 9 * * *
OFFICE_PAYROLL_TZ=Asia/Tokyo
# 雑談 cron（off で無効）
OFFICE_CHAT_CRON=0 * * * *
OFFICE_LOG_LEVEL=info
OFFICE_MAX_AGENT_TURNS=8
OFFICE_TOKEN_BUDGET=20000

# ===== 経済・社会（Phase 5） =====
# 格差の観察 cron と閾値（off で無効。観察のみで行動はしない）
OFFICE_INEQUALITY_CRON=0 * * * *
OFFICE_INEQUALITY_THRESHOLD=500
# オーナーへの質問の回答を待つ上限（§16 エスカレーション。超過すると回答なしで続行）
OFFICE_ANSWER_TIMEOUT=3m

# ===== LLM =====
# mock: 外部 API を呼ばない（既定・無料）/ deepseek: DeepSeek / anthropic: Anthropic
OFFICE_LLM_PROVIDER=mock
# モデル名。未設定ならプロバイダ既定（deepseek-chat / claude-3-5-haiku-latest）
# OFFICE_LLM_MODEL=deepseek-chat
OFFICE_LLM_TIMEOUT=120s
OFFICE_LLM_MAX_TOKENS=1024

# --- DeepSeek（OFFICE_LLM_PROVIDER=deepseek のとき必須） ---
# env でも secrets/deepseek.key でも可。.env に直接書く場合は下のコメントを外す。
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# OFFICE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Anthropic（OFFICE_LLM_PROVIDER=anthropic のとき必須） ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OFFICE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== クライアント（worker / TUI。scripts/client.sh が読み込む） =====
# 別ホストの鯖へ繋ぐ場合は Tailscale のアドレスに変更（例: ws://100.x.y.z:8787/ws）
OFFICE_SERVER_URL=ws://127.0.0.1:8787/ws
# サンドボックス: bwrap（既定） | none
OFFICE_SANDBOX=bwrap
# exec アクションを許可（実務でコードを実行するには 1 が必要。既定は安全側で無効）
OFFICE_ALLOW_EXEC=1

# ===== GitHub（任意・Phase 3） =====
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=
# GITHUB_REPO=owner/name
# GITHUB_BASE_BRANCH=main
